# ==============================================================================
# ELIM SPRINGS — Environment Configuration (SIH 2026 - PS 26015)
# "From Field Voices to Watershed Action"
# ==============================================================================

# Supabase Foundation (Public / Client Configuration)
# Connect to your Supabase Project (https://supabase.com/dashboard)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-placeholder

# Server-Side Supabase Credentials (NEVER expose to browser/client-side code)
SUPABASE_SECRET_KEY=your-supabase-secret-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Modular External Integrations (Server-Side Bhashini Proxy)
# Bhashini ULCA / ASR Service (Keep in backend environment only)
BHASHINI_UDYAT_KEY=your-bhashini-udyat-key-placeholder
BHASHINI_INFERENCE_KEY=your-bhashini-inference-key-placeholder

# Document RAG / AI Embedding Provider
VITE_AI_GEO_AGENT_MODEL=gemini-2.0-flash

# NASA Earth Observation API Key
NASA_API_KEY=your-nasa-api-key-placeholder

# ==========================================
# BHUVAN / NRSC - INDIAN GEO PLATFORM
# ==========================================

# Village Geocoding
BHUVAN_VILLAGE_GEOCODING_TOKEN=your-bhuvan-village-geocoding-token-placeholder

# Village Reverse Geocoding
BHUVAN_REVERSE_GEOCODING_TOKEN=your-bhuvan-reverse-geocoding-token-placeholder

# Proximity APIs
BHUVAN_PROXIMITY_TOKEN=your-bhuvan-proximity-token-placeholder

# LULC 50K Statistics
BHUVAN_LULC_50K_TOKEN=your-bhuvan-lulc-50k-token-placeholder
# LULC 50K AOI Statistics
BHUVAN_LULC_50K_AOI_TOKEN=your-bhuvan-lulc-50k-aoi-token-placeholder

# Routing
BHUVAN_ROUTING_TOKEN=your-bhuvan-routing-token-placeholder

# Geoid Conversion
BHUVAN_GEOID_TOKEN=your-bhuvan-geoid-token-placeholder

# ==========================================
# BHUVAN OGC MAP SERVICES
# ==========================================

# Bhuvan WMS
BHUVAN_WMS_URL="https://bhuvan-ras2.nrsc.gov.in/cgi-bin/flood.exe"
# Bhuvan WMTS
BHUVAN_WMTS_URL="https://bhuvan-vec2.nrsc.gov.in/bhuvan/gwc/service/wmts"