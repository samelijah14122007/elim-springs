# ELIM SPRINGS Python Geo-AI Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ============================================================
# CORS — React frontend origin(s) allowed to call this API
# ============================================================
CORS_ORIGINS=http://localhost:5173

# ============================================================
# Supabase (server-side only — NEVER expose in React frontend)
# ============================================================
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================
# API configuration
# ============================================================
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
